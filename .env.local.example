# ===================================================================
# COPIE ESTE ARQUIVO PARA .env.local E PREENCHA OS VALORES
# (no Windows: copie e renomeie para ".env.local")
# NUNCA comite o .env.local com valores reais.
# ===================================================================

# Chave da API da Anthropic (o "motor" da plataforma).
# Crie em: https://console.anthropic.com  ->  Settings  ->  API Keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Senha de acesso da plataforma (voce inventa).
# Protege sua chave de API de ser usada por qualquer um que ache o link.
# Se deixar em branco, a plataforma abre SEM senha (use so em teste local).
APP_PASSWORD=troque-esta-senha

# (Opcional) Modelo da Anthropic. Padrao: claude-opus-4-8 (melhor qualidade).
# Para gastar menos por video, troque por: claude-sonnet-5
ANTHROPIC_MODEL=claude-opus-4-8
